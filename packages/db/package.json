{
  "name": "@accly/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "bun --bun tsc --noEmit",
    "db:push": "bun --bun drizzle-kit push",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:migrate": "bun src/migrate-command.ts"
  },
  "dependencies": {
    "@accly/env": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@accly/config": "workspace:*",
    "@types/pg": "catalog:",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
