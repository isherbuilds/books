{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "accly",
      "specifier": "./tools/oxlint/accly/index.ts"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".agent/**",
    ".agent-native/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "tools/oxlint/accly/**",
    "tests/fixtures/lint/**"
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "accly/no-pass-through-function": "error",
    "accly/no-motion-on-controls": "error"
  },
  "overrides": [
    {
      "files": ["apps/*/src/**", "packages/*/src/**"],
      "excludeFiles": ["**/routeTree.gen.ts", "**/migrations/**"],
      "rules": {
        "eslint/max-lines": ["warn", { "max": 800, "skipBlankLines": true, "skipComments": true }]
      }
    },
    {
      "files": ["apps/web/**", "packages/ui/**"],
      "rules": {
        "accly/no-manual-memo": "error"
      }
    },
    {
      "files": ["packages/api/src/**"],
      "excludeFiles": ["packages/api/src/lib/procedures/factory.ts"],
      "rules": { "accly/no-permission-in-handler": "error" }
    },
    {
      "files": ["packages/api/src/**", "apps/web/src/**"],
      "excludeFiles": ["packages/api/src/core/document-roles.ts"],
      "rules": { "accly/no-exposure-side-branch": "error" }
    },
    {
      "files": ["packages/api/src/**"],
      "excludeFiles": ["packages/api/src/lib/sql.ts"],
      "rules": { "accly/no-raw-paise-sum": "error" }
    },
    {
      "files": ["packages/api/src/**", "apps/web/src/**"],
      "rules": { "typescript/no-non-null-assertion": "error" }
    },
    {
      "files": [
        "apps/web/src/**",
        "packages/api/src/core/amount-in-words.ts",
        "packages/api/src/core/document-roles.ts",
        "packages/api/src/core/money.ts",
        "packages/api/src/core/note-lines.ts",
        "packages/api/src/core/number-prefixes.ts",
        "packages/api/src/core/tax.ts",
        "packages/api/src/lib/business-date.ts",
        "packages/api/src/lib/document-labels.ts",
        "packages/api/src/lib/import-limits.ts",
        "packages/api/src/lib/indian-states.ts",
        "packages/api/src/lib/normalized-name.ts",
        "packages/api/src/lib/schemas.ts",
        "packages/db/src/schema/account-kinds.ts",
        "packages/db/src/schema/entry-sides.ts",
        "packages/db/src/schema/lock-kinds.ts",
        "packages/db/src/schema/settlement-kinds.ts"
      ],
      "rules": {
        "accly/client-safe-imports": [
          "error",
          { "exempt": ["apps/web/src/lib/orpc.ts", "apps/web/src/lib/pdf-response.ts"] }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.tsx"],
      "rules": { "accly/no-paise-arithmetic-in-components": "error" }
    },
    {
      "files": ["apps/web/src/routes/**"],
      "rules": { "accly/query-options-in-lib": "error" }
    },
    {
      "files": ["apps/web/src/**"],
      "excludeFiles": [
        "apps/web/src/lib/orpc.ts",
        "apps/web/src/routes/api.*",
        "apps/web/src/routeTree.gen.ts"
      ],
      "rules": {
        "accly/paging-from-orpc": "error",
        "accly/no-api-url-literal": "error",
        "accly/write-errors-via-handler": "error"
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-unknown-returns": "off"
      }
    },
    {
      "files": ["**/*.tsx"],
      "rules": {
        "accly/no-bigint-in-components": "error"
      }
    },
    {
      "files": [
        "packages/ui/src/components/dialog.tsx",
        "packages/ui/src/components/popover.tsx",
        "packages/ui/src/components/sheet.tsx",
        "apps/web/src/components/wave-loader.tsx",
        "apps/web/src/components/landing/**"
      ],
      "rules": {
        "accly/no-motion-on-controls": "off"
      }
    }
  ]
}
