{
  "name": "accly",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^18.0.6",
      "zod": "^4.6.5",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.2",
      "hono": "^4.13.13",
      "@orpc/server": "^1.15.5",
      "@orpc/openapi": "^1.15.5",
      "@orpc/zod": "^1.15.5",
      "better-auth": "^1.7.7",
      "evlog": "^2.30.1",
      "lucide-react": "^1.53.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/client": "^1.15.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "drizzle-orm": "^0.45.4",
      "@types/pg": "^8.23.1",
      "react-hook-form": "^7.89.0",
      "@hookform/resolvers": "^5.9.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run db:up && bun run db:migrate && bun --bun turbo run dev",
    "build": "bun --bun turbo run build",
    "check-types": "bun --bun turbo run check-types --output-logs=errors-only && bun --bun tsc --noEmit -p tests/tsconfig.json && bun --bun tsc --noEmit -p tsconfig.json",
    "test": "bun test --max-concurrency 1 --timeout 15000 tests && bun test --max-concurrency 1 --timeout 15000 ./tests/isolated/files-delete-resilience.isolated.ts",
    "dev:web": "bun --bun turbo run dev -F web",
    "dev:server": "bun --bun turbo run dev -F server",
    "dev:status": "bun scripts/dev-status.ts",
    "db:up": "docker compose -f packages/db/docker-compose.dev.yaml up -d --wait",
    "db:studio": "bun --bun turbo run db:studio -F @accly/db",
    "db:generate": "bun --bun turbo run db:generate -F @accly/db",
    "db:migrate": "bun --bun turbo run db:migrate -F @accly/db",
    "db:check": "bun scripts/check-migrations.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:seed:demo": "bun scripts/seed-demo.ts",
    "db:seed:volume": "bun scripts/seed-volume.ts",
    "db:seed:mega": "bun scripts/seed-mega.ts",
    "db:down:clean": "bun scripts/clean-local-services.ts",
    "benchmark:browser": "bun scripts/benchmark-browser.ts",
    "benchmark:navigation": "bun scripts/benchmark-navigation.ts",
    "benchmark:server": "bun scripts/benchmark-server.ts",
    "benchmark:rpc": "bun scripts/benchmark-rpc.ts",
    "create-user": "bun scripts/create-user.ts",
    "create-founder": "bun scripts/create-founder.ts",
    "cleanup-uploads": "bun scripts/cleanup-uploads.ts",
    "check": "bun --bun oxlint && bun --bun oxfmt --write",
    "knip": "bunx knip@5.88.1 --no-progress",
    "verify": "bun --bun oxlint && bun --bun oxfmt --check && bun run check-types && bun run db:check",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@accly/env": "workspace:*"
  },
  "devDependencies": {
    "@accly/api": "workspace:*",
    "@accly/auth": "workspace:*",
    "@accly/config": "workspace:*",
    "@accly/db": "workspace:*",
    "@accly/storage": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@oxlint/plugins": "^1.87.0",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "chrome-devtools-axi": "^0.1.39",
    "drizzle-orm": "catalog:",
    "hucre": "^1.2.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "pg": "^8.23.1",
    "portless": "^0.15.7",
    "takumi-js": "^2.14.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
